---
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, jsonLd = [] } = Astro.props;
if (!Astro.site) throw new Error('Production site URL is required.');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/social-preview.png', Astro.site).href;
const structuredData = jsonLd.length ? jsonLd : [{
  '@context': 'https://schema.org',
  '@type': Astro.url.pathname.startsWith('/about') ? 'AboutPage' : Astro.url.pathname.startsWith('/contact') ? 'ContactPage' : 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en',
}];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={Astro.url.pathname === "/" ? "article" : "website"} />
    <meta property="og:site_name" content="Get Cited" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Get Cited: Evidence on AI, carbon and water" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Get Cited: Evidence on AI, carbon and water" />

    {
      structuredData.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      ))
    }

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        width: auto;
        height: auto;
        overflow: visible;
        z-index: 50;
        background: #ffffff;
        color: #1e293b;
        padding: 0.5rem 1rem;
        border: 2px solid #1e40af;
        border-radius: 0.375rem;
      }
      :focus-visible {
        outline: 3px solid #1e40af;
        outline-offset: 2px;
      }
      table { width: 100%; min-width: 44rem; }
      th, td { overflow-wrap: anywhere; }
      .table-scroll:focus-visible { outline-offset: -3px; }
      a {
        text-underline-offset: 0.2em;
      }
    </style>
  </head>
  <body class="min-h-screen bg-white font-sans text-slate-800 antialiased">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <nav aria-label="Site navigation" class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto flex max-w-4xl flex-wrap gap-x-6 gap-y-2 px-5 py-3 text-sm text-blue-800">
        <a href="/" class="font-semibold">Get Cited</a><a href="/about/">About &amp; editorial policy</a><a href="/contact/">Contact &amp; corrections</a><a href="/privacy/">Privacy</a>
      </div>
    </nav>
    <slot />
  </body>
</html>
